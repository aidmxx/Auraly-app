# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_LOGIN_ID=ADMIN
ADMIN_PASSWORD=replace-with-a-12-letters-password

# AI provider (server-side only; never expose this value to participants)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Free local alternative: set AI_PROVIDER=ollama, install Ollama, and pull the model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
AI_MAX_OUTPUT_TOKENS=600

# Leave blank for local file research-data/auraly.db.
# For production use a managed encrypted libSQL/Turso database:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=